{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "development"
      }
    },

    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview"
      }
    },

    "preview2": {
      "extends": "preview",
      "env": {
        "APP_ENV": "preview2"
      }
    },

    "preview3": {
      "extends": "preview",
      "env": {
        "APP_ENV": "preview3"
      }
    },

    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      },
      "env": {
        "APP_ENV": "production"
      }
    },

    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },

  "submit": {
    "production": {
      "ios": {
        "appleId": "skylerhalisky@gmail.com",
        "ascAppId": "6774709116",
        "appleTeamId": "S78F8ZA8QU"
      },
      "android": {
        "serviceAccountKeyPath": "TODO_PATH_TO_GOOGLE_SERVICE_ACCOUNT_KEY.json",
        "track": "internal"
      }
    }
  }
}
