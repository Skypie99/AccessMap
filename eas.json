{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      }
    },

    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },

    "preview2": {
      "extends": "preview",
      "env": {
        "APP_ENV": "preview2"
      }
    },

    "preview3": {
      "extends": "preview",
      "env": {
        "APP_ENV": "preview3"
      }
    },

    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      }
    }
  },

  "submit": {
    "production": {
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "6774709116",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "TODO_PATH_TO_GOOGLE_SERVICE_ACCOUNT_KEY.json",
        "track": "internal"
      }
    }
  }
}
