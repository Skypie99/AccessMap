{
  "expo": {
    "name": "AccessMap",
    "slug": "accessmap",
    "privacyPolicyUrl": "https://skypie99.github.io/AccessMap/privacy/",
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1466E0"
    },
    "version": "3.0.0",
    "orientation": "portrait",
    "scheme": "accessmap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.accessmap.app",
      "appleTeamId": "S78F8ZA8QU",
      "buildNumber": "15",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AccessMap uses your location to show nearby accessibility flags and to attach your location when you report a new flag.",
        "NSCameraUsageDescription": "AccessMap uses the camera to capture photos of accessibility barriers.",
        "NSPhotoLibraryUsageDescription": "AccessMap needs photo access to attach images to accessibility reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.accessmap.app",
      "versionCode": 2,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "AccessMap",
      "shortName": "AccessMap",
      "description": "Community-powered accessibility map",
      "backgroundColor": "#ffffff",
      "themeColor": "#1466E0",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/"
    },
    "notification": {
      "color": "#1466E0",
      "androidMode": "default"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AccessMap uses your location to show nearby accessibility flags and to attach your location when you report a new flag."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AccessMap needs photo access to attach images to accessibility reports.",
          "cameraPermission": "AccessMap uses the camera to capture photos of accessibility barriers."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a7149107-fb9b-4853-a053-648320c05cb6"
      }
    }
  }
}
