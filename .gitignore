node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
.env
.env.local
.DS_Store

# Claude plugin/skill bundles — sometimes left at the project root by
# external tooling; not part of the AccessMap source tree.
*.skill
*.plugin

# Per-machine Claude Code state. `.claude/launch.json` is committed so
# anyone running the project can use Claude Preview against the Expo
# dev server; everything else under .claude/ is local.
.claude/settings.local.json
.claude/worktrees/

# Jest coverage output — never commit these HTML/JSON artifacts.
# Running `jest --coverage` regenerates them locally.
coverage/

# AccessMap OS v3.2 observability layer — local machine state, not source.
# Immutable cycle ledger, delta engine output, and compressed trend summaries.
.observability/

# Native build dirs — generated by `npx expo prebuild` (CNG).
# Never commit; EAS runs prebuild on clean workers before each build.
/ios
/android

# Supabase CLI per-machine link state. NEVER track this: `linked-project.json`
# records whichever project the last `supabase link` selected, so committing it
# ships a target selector. It was committed by accident in cd9d143 and was found
# during Phase 03A staging naming the PRODUCTION project — meaning a fresh clone
# carried a production target with no staging override. Repointing it at staging
# would only swap one stale dangerous target for another; the target must be
# named explicitly on every command instead (`--project-ref <ref>`).
supabase/.temp/
