{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Task Queue",
  "description": "Roles maintain a 3-item ready queue of features. Morgan reads this to understand blocking dependencies without parsing qa-reports.",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": ["Shamus", "Dani", "Alex", "Steve", "Jordan", "Gary", "Peter", "Will", "Rory", "Dana"]
    },
    "updated": {
      "type": "string",
      "description": "ISO 8601 timestamp of last queue update",
      "example": "2026-05-28T14:32:00Z"
    },
    "queue": {
      "type": "array",
      "maxItems": 3,
      "description": "Up to 3 tasks in priority order. Old tasks rotate out as new ones land.",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "branch"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Short identifier (e.g., 'feat-clustering', 'fix-darkmode')",
            "example": "feat-clustering"
          },
          "name": {
            "type": "string",
            "description": "One-line human-readable task name",
            "example": "Marker clustering + flag edit UI + tests"
          },
          "status": {
            "type": "string",
            "enum": ["ready-to-merge", "in-code-review", "blocked", "in-progress", "testing"],
            "description": "Current phase"
          },
          "branch": {
            "type": "string",
            "description": "GitHub branch name",
            "example": "shamus/marker-clustering-2026-05-25"
          },
          "blockers": {
            "type": "array",
            "description": "Which decisions or dependencies block this task",
            "items": {
              "type": "string",
              "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "other-task-id"]
            },
            "example": ["D1"]
          },
          "merge_eta": {
            "type": "string",
            "description": "When this task is expected to merge to main (if known)",
            "example": "2026-05-29 EOD"
          },
          "depends_on": {
            "type": "array",
            "description": "Other task IDs that must land first",
            "items": { "type": "string" },
            "example": ["wave3-a11y", "gary-tests"]
          },
          "unblocks": {
            "type": "array",
            "description": "Which features/tasks are waiting on this",
            "items": { "type": "string" },
            "example": ["dani-polish-phase", "will-ux-refinement"]
          },
          "tests_added": {
            "type": "integer",
            "description": "Number of new tests in this branch",
            "example": 20
          },
          "notes": {
            "type": "string",
            "description": "Optional status note (e.g., 'Alex a11y audit complete', 'waiting for Sky D1')",
            "example": "Code review done, Gary tests passing, ready once D1 applied"
          }
        }
      }
    }
  }
}
